<!doctype html>
<html lang="{{ page.lang | default: site.lang | default: 'en' }}" dir="{{ page.direction | default: site.direction | default: 'ltr' }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body>
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <main class="container site-main{% if page.toc and page.toc.sidebar %} container--with-toc{% endif %}" role="main">
      {% if page.toc and page.toc.sidebar %}
        <div class="toc-layout{% if page.toc.sidebar == 'right' %} toc-layout--right{% endif %}">
          {% if page.toc.sidebar == 'right' %}
            <div class="toc-main">{{ content }}</div>
            <aside class="toc-column" aria-label="Table of contents">
              <nav id="toc-sidebar" class="toc-nav"></nav>
            </aside>
          {% else %}
            <aside class="toc-column" aria-label="Table of contents">
              <nav id="toc-sidebar" class="toc-nav"></nav>
            </aside>
            <div class="toc-main">{{ content }}</div>
          {% endif %}
        </div>
      {% else %}
        {{ content }}
      {% endif %}
    </main>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
