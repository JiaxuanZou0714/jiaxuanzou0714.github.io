---
layout: default
---
<div class="post">
  <header class="post-header">
    {% if page.type == 'categories' %}
      <h1 class="post-title">Category: {{ page.title }}</h1>
    {% elsif page.type == 'year' %}
      <h1 class="post-title">{{ page.date | date: '%Y' }}</h1>
    {% elsif page.type == 'tags' %}
      <h1 class="post-title">#{{ page.title }}</h1>
    {% endif %}
  </header>

  <article class="archive">
    <table class="minimal-list-table">
      {% for document in page.documents %}
        <tr>
          <th scope="row">{{ document.date | date: '%Y-%m-%d' }}</th>
          <td>
            {% if document.redirect == blank %}
              <a class="post-link" href="{{ document.url | relative_url }}">{{ document.title }}</a>
              {% if site.enable_goatcounter_analytics %}
                <span class="archive-views post-views" {% include goatcounter-paths.liquid document=document %}>
                  (<span class="goatcounter-count">--</span> views)
                </span>
              {% endif %}
            {% elsif document.redirect contains '://' %}
              <a class="post-link" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
            {% else %}
              <a class="post-link" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>
  </article>
</div>
