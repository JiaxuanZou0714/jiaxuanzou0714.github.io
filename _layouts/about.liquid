---
layout: default
---
<div class="post about-home">
  <header class="post-header about-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
      <span class="name-zh">（邹嘉轩）</span>
    </h1>
    {% if page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
    {% if page.social %}
      <p class="about-links">
        <a href="{{ '/cv/#contact-email' | relative_url }}">Email</a>
        &middot;
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="external nofollow noopener">Google Scholar</a>
        &middot;
        <a href="https://x.com/{{ site.data.socials.x_username }}" target="_blank" rel="external nofollow noopener">X</a>
        &middot;
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="external nofollow noopener">LinkedIn</a>
        &middot;
        <a href="{{ site.data.socials.bilibili_social.url }}" target="_blank" rel="external nofollow noopener">Bilibili</a>
        &middot;
        <a href="{{ site.data.socials.xiaohongshu_social.url }}" target="_blank" rel="external nofollow noopener">Xiaohongshu</a>
        &middot;
        <span>WeChat: Jiaxuan_Zou</span>
      </p>
    {% endif %}
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture profile_image_alt %}
            {% if page.profile.alt %}
              {{ page.profile.alt }}
            {% elsif site.title == 'blank' %}
              {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
          {% endcapture %}
          {% assign profile_image_alt = profile_image_alt | strip %}
          {%
            include figure.liquid loading="eager" decoding="async" fetchpriority="high" path=profile_image_path class="img-fluid profile-photo" sizes="200px" alt=profile_image_alt
            width="1024" height="1024"
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section">
        <h2>
          <a href="{{ '/news/' | relative_url }}">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section">
        <h2>
          <a href="{{ '/blog/' | relative_url }}">Latest Posts</a>
        </h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section">
        <h2>
          <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}
  </article>
</div>
