# Copy to .env and fill in. .env is gitignored and must never be committed.
# Used only by scripts/translate.mjs; the deploy workflow does not read it.

DEEPSEEK_API_KEY=

# Optional overrides.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
# TRANSLATE_CONCURRENCY=6
# TRANSLATE_MAX_TOKENS=8192

# V4 models think by default and bill reasoning at the output rate, which
# translation does not benefit from. "enabled" turns it back on; "default"
# sends no flag at all.
# DEEPSEEK_THINKING=disabled
