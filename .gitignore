# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Lockfiles are committed for reproducible CI builds

# Ignore files created by npm
node_modules

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/
.DS_Store

# Ignore LaTeX build artifacts from the CV source.
# The built PDF is committed only at its published path, assets/Jiaxuan_Zou_CV.pdf.
cv/*.aux
cv/*.log
cv/*.out
cv/*.fls
cv/*.fdb_latexmk
cv/*.synctex.gz
cv/Jiaxuan_Zou_CV.pdf
