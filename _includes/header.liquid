<header class="site-header">
  <div class="container">
    <nav class="site-nav" role="navigation" aria-label="Main navigation">
      {% if page.permalink != '/' %}
        <a class="site-title" href="{{ '/' | relative_url }}">
          {%- if site.title == 'blank' -%}
            {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
          {%- else -%}
            {{ site.title }}
          {%- endif -%}
        </a>
      {% endif %}

      <ul class="site-nav-links">
        {% for p in site.pages %}
          {% if p.permalink == '/' %}{% assign about_title = p.title %}{% endif %}
        {% endfor %}
        <li class="{% if page.permalink == '/' %}active{% endif %}">
          <a href="{{ '/' | relative_url }}">{{ about_title | default: 'About' }}</a>
        </li>

        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null %}
            {% unless p.dropdown %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              {%- if p.permalink contains '://' -%}
                {%- assign nav_url = p.permalink -%}
              {%- elsif p.permalink contains '/blog/' -%}
                {%- assign nav_url = '/blog/' -%}
              {%- else -%}
                {%- assign nav_url = p.url -%}
              {%- endif %}
              <li class="{% if page.url contains parent_link %}active{% endif %}">
                <a href="{{ nav_url | relative_url }}">{{ p.title }}</a>
              </li>
            {% endunless %}
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
