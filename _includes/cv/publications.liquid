<ul class="cv-entries">
  {% for entry in entries %}
    {% assign pub_date = entry.releaseDate | default: entry.date | strip %}
    <li class="cv-entry">
      <div class="cv-date">{{ pub_date | split: '-' | first }}</div>
      <div class="cv-body">
        <div class="cv-title">
          {% if entry.url %}
            <a href="{{ entry.url }}" target="_blank" rel="external nofollow noopener"><strong>{{ entry.title | default: entry.name }}</strong></a>
          {% else %}
            <strong>{{ entry.title | default: entry.name }}</strong>
          {% endif %}
        </div>
        {% if entry.summary %}
          <div class="cv-subtitle">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
        {% endif %}
        {% if entry.publisher %}
          <div class="cv-meta"><em>{{ entry.publisher }}</em></div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
