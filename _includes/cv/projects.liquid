<ul class="cv-entries">
  {% for entry in entries %}
    <li class="cv-entry cv-entry--plain">
      <div class="cv-body">
        <div class="cv-title">
          {% if entry.url %}
            <strong><a href="{{ entry.url }}" target="_blank" rel="external nofollow noopener">{{ entry.name }}</a></strong>
          {% else %}
            <strong>{{ entry.name }}</strong>
          {% endif %}
        </div>
        {% if entry.summary %}
          <div class="cv-note">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
        {% endif %}
        {% if entry.highlights %}
          <ul class="cv-highlights">
            {% for item in entry.highlights %}
              <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
