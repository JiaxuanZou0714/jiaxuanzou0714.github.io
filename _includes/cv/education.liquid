<ul class="cv-entries">
  {% for entry in entries %}
    {% assign start_date = entry.start_date | default: entry.startDate | strip %}
    {% assign end_date = entry.end_date | default: entry.endDate | strip %}
    {% if start_date != '' %}
      {% assign date_label = start_date | append: ' – ' | append: end_date %}
      {% if end_date == '' %}{% assign date_label = start_date | append: ' – Present' %}{% endif %}
    {% else %}
      {% assign date_label = '' %}
    {% endif %}
    <li class="cv-entry">
      <div class="cv-date">{{ date_label }}</div>
      <div class="cv-body">
        <div class="cv-title">
          <strong>{{- entry.institution -}}</strong>{%- if entry.location -%}<span class="cv-meta">, {{ entry.location }}</span>{%- endif -%}
        </div>
        {% assign study_type = entry.studyType | default: entry.degree %}
        {% if study_type or entry.area %}
          <div class="cv-subtitle">
            {{ study_type }}{% if study_type and entry.area %} in {% endif %}{{ entry.area }}
          </div>
        {% endif %}
        {% if entry.courses or entry.highlights %}
          <ul class="cv-highlights">
            {% for item in entry.courses %}
              <li>{{ item }}</li>
            {% endfor %}
            {% for item in entry.highlights %}
              <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
