<ul class="cv-entries">
  {% for entry in entries %}
    {% assign award_date = entry.date | strip %}
    <li class="cv-entry">
      <div class="cv-date">{{ award_date | split: '-' | first }}</div>
      <div class="cv-body">
        <div class="cv-title">
          {%- if entry.url -%}
            <a href="{{ entry.url }}" target="_blank" rel="external nofollow noopener"><strong>{{- entry.title -}}</strong></a>
          {%- else -%}
            <strong>{{- entry.title -}}</strong>
          {%- endif -%}
          {%- if entry.awarder -%}<span class="cv-meta">, {{ entry.awarder }}</span>{%- endif -%}
        </div>
        {% if entry.summary %}
          <div class="cv-note">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
