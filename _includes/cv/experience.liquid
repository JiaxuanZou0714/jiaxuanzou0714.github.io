<ul class="cv-entries">
  {% for entry in entries %}
    {% assign start_date = entry.start_date | default: entry.startDate | strip %}
    {% assign end_date = entry.end_date | default: entry.endDate | strip %}
    {% if start_date != '' %}
      {% assign date_label = start_date | append: ' – ' | append: end_date %}
      {% if end_date == '' %}{% assign date_label = start_date | append: ' – Present' %}{% endif %}
    {% else %}
      {% assign date_label = '' %}
    {% endif %}
    {% assign company_name = entry.name | default: entry.company | default: entry.organization %}
    <li class="cv-entry">
      <div class="cv-date">{{ date_label }}</div>
      <div class="cv-body">
        <div class="cv-title">
          {%- if entry.position -%}<strong>{{- entry.position -}}</strong>{%- endif -%}
          {%- if company_name -%}
            {%- if entry.position -%}, {% endif -%}
            {%- if entry.url -%}
              <a href="{{ entry.url }}" target="_blank" rel="external nofollow noopener">{{ company_name }}</a>
            {%- else -%}
              {{ company_name }}
            {%- endif -%}
          {%- endif -%}
          {%- if entry.location -%}<span class="cv-meta"> ({{ entry.location }})</span>{%- endif -%}
        </div>
        {% if entry.summary %}
          <div class="cv-note">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
        {% endif %}
        {% if entry.highlights %}
          <ul class="cv-highlights">
            {% for item in entry.highlights %}
              <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
