<li class="project-item">
  <div class="project-title">
    <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"{% if project.redirect contains '://' %} target="_blank" rel="external nofollow noopener"{% endif %}>{{ project.title }}</a>
    {% if project.github %}
      <span class="project-links">[<a href="{{ project.github }}" target="_blank" rel="external nofollow noopener">Code</a>]</span>
    {% endif %}
  </div>
  {% if project.description %}
    <p class="project-desc">{{ project.description }}</p>
  {% endif %}
</li>
